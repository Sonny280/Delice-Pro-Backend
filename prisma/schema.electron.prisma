// ═══════════════════════════════════════════════════════════════
// prisma/schema.electron.prisma
// GÉNÉRÉ AUTOMATIQUEMENT depuis schema.prisma — NE PAS ÉDITER À LA MAIN.
// Pour modifier les modèles : édite schema.prisma puis relance
//   npm run schema:electron
//
// Différences automatiques par rapport à schema.prisma (SQLite
// n'accepte ni enum, ni Json, ni @db.Text) :
//   - les enums sont convertis en String (valeurs identiques,
//     simplement plus de contrainte au niveau de la base — la
//     validation Zod côté API reste la seule garde-fou, comme avant)
//   - les champs Json sont convertis en String (JSON sérialisé à la
//     main — voir les commentaires "SQLITE" dans le code backend)
// ═══════════════════════════════════════════════════════════════

// prisma/schema.prisma — DELICE PRO

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-electron"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom               String
  type              String  @default("Pâtisserie")
  adresse           String?
  ville             String?
  pays              String?
  telephone         String?
  email             String?
  siteWeb           String?
  logoUrl           String?
  devise            String  @default("F")
  couleurPrincipale String  @default("#1a2744")
  heureCloture      String  @default("17:00")
  objectifCA        Float   @default(0)
  seuilPertes       Float   @default(0)
  chargesFixesMensuelles Float @default(0)

  // ─── ABONNEMENT / FACTURATION ────────────────────────────────
  plan                 String              @default("ESSAI")
  statutAbonnement      String  @default("ESSAI")
  dateFinEssai          DateTime?         // fin des 14-21 jours gratuits
  dateProchainPaiement  DateTime?         // prochaine échéance mensuelle
  montantAbonnement     Float             @default(0) // en FCFA
  paiements             Paiement[]

  users                User[]
  categories           Categorie[]
  unites               Unite[]
  fournisseurs         Fournisseur[]
  matieresPremieres    MatierePremiere[]
  recettes             Recette[]
  produits             Produit[]
  productions          Production[]
  patons               Paton[]
  ventes               Vente[]
  sessionsCaisse       SessionCaisse[]
  pertes               Perte[]
  clients              Client[]
  commandesClient      CommandeClient[]
  commandesFournisseur CommandeFournisseur[]
  cloturesJournee      CloturJournee[]
  lotsStock            LotStock[]
  favorisProduits      FavorisProduit[]
  categoriesCharge     CategorieCharge[]
  charges              Charge[]
  // AJOUT — plages horaires de clôture (1 pour mono-clôture, N pour équipes)
  plagesHoraires       PlageHoraire[]
}

// USER — sans 2FA, sans resetToken (gestion par admin)
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prenom       String
  nom          String
  email        String
  // AJOUT : Nom d'utilisateur unique pour la connexion
  // Généré automatiquement depuis prénom.nom — modifiable dans Mon Profil
  username     String?
  passwordHash String
  role         String    @default("CAISSIER")
  actif        Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productions     Production[]
  ventes          Vente[]
  sessionsCaisse  SessionCaisse[]
  cloturesJournee CloturJournee[]

  @@unique([email, companyId])
  @@unique([username, companyId])
}

// Historique des paiements (utile pour factures + support client)
model Paiement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  montant       Float
  plan          String
  moyenPaiement String   // "WAVE", "ORANGE_MONEY", "MANUEL"
  reference     String?  // référence transaction envoyée par l'agrégateur
  statut        String   @default("EN_ATTENTE") // EN_ATTENTE | CONFIRME | ECHOUE
}

model Categorie {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  nom      String
  type     String
  margeMin Float?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  produits          Produit[]
  matieresPremieres MatierePremiere[]
}

model Unite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  nom         String
  abreviation String
  type        String
  uniteBase   String
  coefficient Float

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  matieresPremieres  MatierePremiere[]   @relation("UniteStockage")
  recetteIngredients RecetteIngredient[]
}

model Fournisseur {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom                String
  contact            String?
  telephone          String?
  email              String?
  adresse            String?
  delaiLivraison     String?
  conditionsPaiement String?
  actif              Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  matieresPremieres MatierePremiere[]
  commandes         CommandeFournisseur[]
}

model MatierePremiere {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom         String
  prixAchat   Float   @default(0)
  stockActuel Float   @default(0)
  seuilAlerte Float   @default(0)
  actif       Boolean @default(true)
  stockGere   Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categorieId String?
  categorie   Categorie? @relation(fields: [categorieId], references: [id])

  uniteId String?
  unite   Unite?  @relation("UniteStockage", fields: [uniteId], references: [id])

  fournisseurId String?
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])

  recetteIngredients RecetteIngredient[]
  mouvementsStock    MouvementStock[]
  lignesCommandeF    LigneCommandeFournisseur[]
  pertes             Perte[]
}

model MouvementStock {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type     String
  quantite Float
  motif    String?

  mpId String
  mp   MatierePremiere @relation(fields: [mpId], references: [id], onDelete: Cascade)
}

model Recette {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom                      String
  description              String?
  ratioPate                Float   @default(1.0)
  tauxPerte                Float   @default(0)
  estViennoiserie          Boolean @default(false)
  ingredientReference      String  @default("FARINE")
  ingredientReferenceNom   String  @default("Farine")
  ingredientReferenceUnite String  @default("kg")
  categorie                String?
  actif                    Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ingredients RecetteIngredient[]
  produits    Produit[]
  productions Production[]
}

model RecetteIngredient {
  id       String @id @default(cuid())
  quantite Float

  recetteId String
  recette   Recette @relation(fields: [recetteId], references: [id], onDelete: Cascade)

  mpId String
  mp   MatierePremiere @relation(fields: [mpId], references: [id])

  uniteId String?
  unite   Unite?  @relation(fields: [uniteId], references: [id])
}

model Produit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom         String
  prixVente   Float
  prixAchat   Float    @default(0)
  margeMin    Float    @default(25)
  grammage    Float?
  stockActuel Float    @default(0)
  seuilAlerte Float    @default(10)
  actif       Boolean  @default(true)
  dlvJours    Int      @default(1)
  estSemiFini Boolean  @default(false)
  imageUrl    String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categorieId String?
  categorie   Categorie? @relation(fields: [categorieId], references: [id])

  recetteId String?
  recette   Recette? @relation(fields: [recetteId], references: [id])

  lignesVente      LigneVente[]
  lignesCommande   LigneCommandeClient[]
  pertes           Perte[]           @relation("PerteProduit")
  patons           Paton[]
  lignesProduction LigneProduction[]
  lotsStock        LotStock[]
  favoris          FavorisProduit[]
}

model FavorisProduit {
  id        String  @id @default(cuid())
  produitId String
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  position  Int     @default(0)

  @@unique([companyId, produitId])
  @@index([companyId, position])
}

model LigneProduction {
  id            String @id @default(cuid())
  produitId     String
  produit       Produit @relation(fields: [produitId], references: [id])
  quantite      Int
  poidsUnitaire Float
  poidsTotal    Float
  productionId  String
  production    Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
}

model Production {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  numeroPetrin          Int              @default(1)
  sessionProd           String           @default("NUIT")
  nomPetrisseur         String?
  heureDebut            DateTime?
  heureFin              DateTime?
  quantiteFarine        Float
  pateTheorique         Float
  pateEffective         Float            @default(0)
  difference            Float            @default(0)
  ecartPct              Float            @default(0)
  pateRetournee         Float            @default(0)
  pateRecuperee         Float            @default(0)
  pateGatee             Float            @default(0)
  causeGatee            String?
  pateGardee            Float            @default(0)
  destinationPateGardee String?
  categorieProd         String    @default("BOULANGERIE")
  statut                String @default("EN_ATTENTE")
  typeProduction        String   @default("VENTE")
  nomClient             String?
  date                  DateTime         @default(now())
  dateTerminaison       DateTime?
  notes                 String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  recetteId String
  recette   Recette @relation(fields: [recetteId], references: [id])

  userId String
  user   User @relation(fields: [userId], references: [id])

  lignesProduction LigneProduction[]
  patons           Paton[]
  lotsStock        LotStock[]
}

model Paton {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  poids         Float
  poidsBeurre   Float       @default(0)
  poidsTotal    Float       @default(0)
  nbPieces      Int         @default(0)
  rendement     Float       @default(0)
  statutPaton   String @default("EN_CHAMBRE_FROIDE")
  dateFaconnage DateTime?

  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionId String
  production   Production @relation(fields: [productionId], references: [id])
  produitId    String?
  produit      Produit?   @relation(fields: [produitId], references: [id])
}

model SessionCaisse {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  ouverteA       DateTime  @default(now())
  fermeeA        DateTime?
  fondInitial    Float     @default(0)
  totalVentes    Float     @default(0)
  nbTransactions Int       @default(0)
  statut         String    @default("OUVERTE")

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, ouverteA])
  @@index([userId])
}

model Vente {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  montantTotal    Float
  montantBrut     Float        @default(0)
  remiseMontant   Float        @default(0)
  remisePct       Float        @default(0)
  modePaiement    String @default("ESPECES")
  date            DateTime     @default(now())
  notes           String?
  numero          Int?
  statut          String       @default("VALIDEE")
  motifAnnulation String?
  splitPaiement   Boolean      @default(false)
  split1Mode      String?
  split1Montant   Float?
  split2Mode      String?
  split2Montant   Float?
  nomClient       String?
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  lignes LigneVente[]

  @@index([companyId, date])
  @@index([companyId, modePaiement])
  @@index([clientId])
}

model LigneVente {
  id           String  @id @default(cuid())
  quantite     Int
  prixUnitaire Float
  sousTotal    Float

  venteId   String
  vente     Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)
  produitId String
  produit   Produit @relation(fields: [produitId], references: [id])
}

model Perte {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  type      String
  quantite  Float
  valeur    Float
  cause     String
  date      DateTime  @default(now())
  notes     String?
  deductMP  Boolean   @default(true)
  // AJOUT — distingue une perte déclarée en production (cassé, raté)
  // d'un invendu déclaré à la vente/clôture — évite le double comptage
  // signalé par le client dans le document de clôture.
  origine   String @default("VENTE")

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  produitId String?
  produit   Produit? @relation("PerteProduit", fields: [produitId], references: [id])

  mpId String?
  mp   MatierePremiere? @relation(fields: [mpId], references: [id])

  @@index([companyId, date])
  @@index([companyId, type])
}

// AJOUT — origine d'une perte : production (cassé/raté avant vente)
// ou vente (invendu constaté à la clôture / DLV dépassée)

model Client {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  nom         String
  type        String @default("PARTICULIER")
  telephone   String?
  email       String?
  adresse     String?
  entreprise  String?
  notes       String?
  actif       Boolean    @default(true)
  soldeCredit Float      @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  commandes CommandeClient[]
  ventes    Vente[]
}

model CommandeClient {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  reference     String
  statut        String @default("RECUE")
  dateLivraison DateTime
  montantTotal  Float                @default(0)
  acompte       Float                @default(0)
  modePaiement  String         @default("ESPECES")
  notes         String?

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  lignes LigneCommandeClient[]

  @@index([companyId, statut])
  @@index([companyId, dateLivraison])
  @@index([clientId])
}

model LigneCommandeClient {
  id           String @id @default(cuid())
  quantite     Int
  prixUnitaire Float
  sousTotal    Float

  commandeId String
  commande   CommandeClient @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produitId  String
  produit    Produit        @relation(fields: [produitId], references: [id])
}

model CommandeFournisseur {
  id                  String                    @id @default(cuid())
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  reference           String
  statut              String @default("BROUILLON")
  dateCommande        DateTime                  @default(now())
  dateLivraisonPrevue DateTime?
  dateLivraisonReelle DateTime?
  montantTotal        Float                     @default(0)
  notes               String?
  userId              String?

  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  lignes LigneCommandeFournisseur[]
}

model LigneCommandeFournisseur {
  id            String @id @default(cuid())
  quantite      Float
  prixUnitaire  Float
  sousTotal     Float
  quantiteRecue Float  @default(0)

  commandeId String
  commande   CommandeFournisseur @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  mpId       String
  mp         MatierePremiere     @relation(fields: [mpId], references: [id])
}

model LotStock {
  id               String     @id @default(cuid())
  createdAt        DateTime   @default(now())
  produitId        String
  produit          Produit    @relation(fields: [produitId], references: [id])
  productionId     String?
  production       Production? @relation(fields: [productionId], references: [id])
  quantiteInitiale Int
  quantiteRestante Int
  dateCreation     DateTime
  dateExpiration   DateTime
  dlvJours         Int
  statut           String  @default("ACTIF")
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notesExpiration  String?

  @@index([companyId, statut])
  @@index([companyId, dateExpiration])
  @@index([produitId, statut])
}

// AJOUT — Plage horaire de clôture. Une entreprise mono-clôture n'a
// qu'une seule plage ("Journée", ex 00:00-23:59, comportement identique
// à avant cette évolution). Une entreprise à équipes définit plusieurs
// plages avec leurs propres horaires (ex : Équipe Matin 05:00-13:00,
// Équipe Après-midi 13:00-21:00).
model PlageHoraire {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  nom        String   // "Journée", "Équipe Matin", "Équipe Après-midi"...
  heureDebut String   // "05:00"
  heureFin   String   // "13:00"
  ordre      Int      @default(0)
  actif      Boolean  @default(true)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clotures  CloturJournee[]

  @@index([companyId, ordre])
}

model CloturJournee {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  date             DateTime
  heureRealisation DateTime
  caTotal          Float    @default(0)
  nbTransactions   Int      @default(0)
  totalEspeces     Float    @default(0)
  totalMobile      Float    @default(0)
  totalCarte       Float    @default(0)
  totalVirement    Float    @default(0)
  totalCredit      Float    @default(0)
  nbInvendus       Int      @default(0)
  valeurInvendus   Float    @default(0)
  nbPertes         Int      @default(0)
  valeurPertes     Float    @default(0)
  fondCaisse       Float?
  ecartFond        Float?
  notes            String?

  // AJOUT — plage horaire (équipe) concernée par cette clôture.
  // Null = ancien enregistrement (avant cette évolution), conservé
  // tel quel pour compatibilité.
  plageHoraireId String?
  plageHoraire   PlageHoraire? @relation(fields: [plageHoraireId], references: [id])

  // AJOUT — instantané du stock produits au moment de la clôture,
  // sert de "reçu de passation" affiché à l'équipe suivante.
  stockSnapshot String?

  // AJOUT — vérification croisée par la formule du client
  // (stock départ + reçu − stock restant − invendus)
  caVerifieParStock Float?
  ecartVerification Float?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@index([companyId, date, plageHoraireId])
}

model CategorieCharge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  nom       String
  icone     String   @default("📋")
  couleur   String   @default("#6B7280")
  ordre     Int      @default(0)
  actif     Boolean  @default(true)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  charges   Charge[]

  @@index([companyId])
}

model Charge {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  libelle    String
  montant    Float
  date       DateTime @default(now())
  notes      String?
  recurrence String   @default("PONCTUELLE")
  moisRef    Int?
  anneeRef   Int?

  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categorieId String
  categorie   CategorieCharge @relation(fields: [categorieId], references: [id])

  @@index([companyId, date])
  @@index([companyId, categorieId])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String
  entite    String?
  entiteId  String?
  details   String?
  ip        String?
  userId    String?
  companyId String

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([action])
}

// Suit les postes (ordinateurs/navigateurs) actuellement connectés par
// entreprise, pour appliquer la limite du plan (ex: Standard = 5 postes).
// Un poste sans activité depuis 15 min est considéré inactif et ne compte
// plus dans la limite — libère automatiquement sa place, sans action
// manuelle (ordinateur éteint, onglet fermé, etc.).
model PosteActif {
  id            String   @id @default(cuid())
  companyId     String
  deviceId      String   // identifiant généré et stocké côté navigateur
  derniereActivite DateTime @default(now()) @updatedAt

  @@unique([companyId, deviceId])
  @@index([companyId, derniereActivite])
}

